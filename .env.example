# ============================================================
# eos-proposal-uplift — variaveis de ambiente
# ============================================================
# Copie pra .env (gitignored) e ajuste pra seu setup local.

# Postgres (docker-compose up sobe na porta 5432)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eos_proposal"

# Redis (opcional pro slice de proposta — usado pelo cache layer do monorepo de destino)
REDIS_URL="redis://localhost:6379"

# Backoffice Next.js
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
NODE_ENV="development"
